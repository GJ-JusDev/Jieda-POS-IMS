<Window x:Class="InventoryManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeida Crafts &amp; Prints - Inventory Management System" Icon="app.ico" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="#2c3e50" Padding="10">
            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/JeidaLogo.png" Height="30" Margin="0,0,10,0"/>
                    <TextBlock Text="Jeida Crafts &#38; Prints - Inventory Management System" Foreground="White" FontSize="18" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserInfo" Foreground="White" Margin="0,0,15,0" VerticalAlignment="Center"/>
                    <Button Content="Logout" Padding="10,5" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Sidebar and Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#ecf0f1" BorderBrush="#bdc3c7" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10,0,0">
                    <Button Content="Dashboard" Margin="10,5" Padding="10" Click="BtnDashboard_Click"/>
                    <Button Content="Products" Margin="10,5" Padding="10" Click="BtnProducts_Click"/>
                    <Button Content="Inventory" Margin="10,5" Padding="10" Click="BtnInventory_Click"/>
                    <Button Content="Purchasing" Margin="10,5" Padding="10" Click="BtnPurchasing_Click"/>
                    <Button Content="Sales" Margin="10,5" Padding="10" Click="BtnSales_Click"/>
                    <Button Content="Reports" Margin="10,5" Padding="10" Click="BtnReports_Click"/>
                    <Button Content="Administration" Margin="10,5" Padding="10" x:Name="btnAdministration" Click="BtnAdministration_Click"/>
                    <Button Content="Audit Logs" Margin="10,5" Padding="10" x:Name="btnAuditLogs" Click="BtnAuditLogs_Click"/>
                </StackPanel>
            </Border>
            
            <!-- Main Content Area -->
            <Border Grid.Column="1" Padding="20">
                <ContentControl x:Name="MainContent" />
            </Border>
        </Grid>
    </Grid>
</Window>












