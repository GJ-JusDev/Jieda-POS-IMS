<Window x:Class="InventoryManagement.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jeida Crafts &amp; Prints - Inventory Management System" Icon="app.ico" MinHeight="600" MinWidth="800" Height="700" Width="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/JeidaLogo.png" Height="36" Margin="0,0,15,0"/>
                    <TextBlock Text="Jeida Crafts &#38; Prints - Inventory Management System" Foreground="{StaticResource TextInverseBrush}" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="txtUserInfo" Foreground="{StaticResource TextInverseBrush}" Margin="0,0,20,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"/>
                    <Button Content="Logout" Padding="15,6" Click="BtnLogout_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Sidebar and Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,15,0,15">
                        <Button Content="Dashboard" Style="{StaticResource SidebarButton}" Click="BtnDashboard_Click"/>
                        <Button Content="Products" Style="{StaticResource SidebarButton}" Click="BtnProducts_Click"/>
                        <Button Content="Inventory" Style="{StaticResource SidebarButton}" Click="BtnInventory_Click"/>
                        <Button Content="Purchasing" Style="{StaticResource SidebarButton}" Click="BtnPurchasing_Click"/>
                        <Button Content="Sales" Style="{StaticResource SidebarButton}" Click="BtnSales_Click"/>
                        <Button Content="Reports" Style="{StaticResource SidebarButton}" Click="BtnReports_Click"/>
                        <Button Content="Administration" x:Name="btnAdministration" Style="{StaticResource SidebarButton}" Click="BtnAdministration_Click"/>
                        <Button Content="Audit Logs" x:Name="btnAuditLogs" Style="{StaticResource SidebarButton}" Click="BtnAuditLogs_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Main Content Area -->
            <Border Grid.Column="1" Padding="15">
                <ContentControl x:Name="MainContent" />
            </Border>
        </Grid>
    </Grid>
</Window>












