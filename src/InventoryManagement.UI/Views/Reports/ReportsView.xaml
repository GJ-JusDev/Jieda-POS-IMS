<UserControl x:Class="InventoryManagement.UI.Views.Reports.ReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" Padding="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <WrapPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="Start Date:" Style="{StaticResource Heading3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="140" Padding="5" VerticalAlignment="Center"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="End Date:" Style="{StaticResource Heading3}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="140" Padding="5" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                    <Button Content="Generate Report" Command="{Binding GenerateReportCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0" Padding="20,2"/>
                    <Button Content="Export PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource SuccessButton}" Padding="20,2"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Tab Control for different reports -->
        <TabControl Grid.Row="1" Margin="20" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="10">
            <TabItem Header="Stock Movement" Padding="15,10">
                <DataGrid ItemsSource="{Binding StockMovements}" BorderThickness="0" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=g}" Width="160"/>
                        <DataGridTextColumn Header="Transaction Type" Binding="{Binding TransactionType}" Width="150"/>
                        <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/>
                        <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Bold"/>
                                    <Setter Property="HorizontalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Sales Report" Padding="15,10">
                <DataGrid ItemsSource="{Binding SalesReports}" BorderThickness="0" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=g}" Width="160"/>
                        <DataGridTextColumn Header="Invoice No" Binding="{Binding InvoiceNumber}" Width="150"/>
                        <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName}" Width="*"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="Purchase Report" Padding="15,10">
                <DataGrid ItemsSource="{Binding PurchaseReports}" BorderThickness="0" Margin="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat=g}" Width="160"/>
                        <DataGridTextColumn Header="Purchase No" Binding="{Binding PurchaseNumber}" Width="150"/>
                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName}" Width="*"/>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130"/>
                        <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, StringFormat=C}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>


