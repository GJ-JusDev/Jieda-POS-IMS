<Window x:Class="InventoryManagement.UI.Views.Inventory.StockAdjustmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stock Adjustment" Height="450" Width="500" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Product:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
            <TextBlock Text="{Binding SelectedProduct.ProductName, TargetNullValue='(Scan barcode or select product)'}" VerticalAlignment="Center"/>
            <Button Content="📷 Scan" Command="{Binding OpenCameraScannerCommand}" Margin="15,0,0,0" Padding="10,2" Background="#6c757d" Foreground="White" BorderThickness="0" ToolTip="Camera Scan"/>
        </StackPanel>

        <TextBlock Text="Current Stock:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBlock Text="{Binding CurrentStock}" Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="0,8" FontSize="16" FontWeight="Bold"/>

        <TextBlock Text="Adjustment Type:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <ComboBox ItemsSource="{Binding AvailableTypes}" SelectedItem="{Binding SelectedType}" Grid.Row="2" Grid.Column="1" Margin="0,8" />

        <TextBlock Text="Quantity:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,8">
            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="100"/>
            <TextBlock Text="(Use + or - for Manual)" Visibility="{Binding IsDirectionalHintVisible, Converter={StaticResource BooleanToVisibilityConverter}}" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMutedBrush}"/>
        </StackPanel>

        <TextBlock Text="Resulting Stock:" Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBlock Text="{Binding ResultingStock}" Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" Margin="0,8" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>

        <TextBlock Text="Notes / Reason:" Grid.Row="5" Grid.Column="0" VerticalAlignment="Top" Margin="0,15,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox Text="{Binding Notes}" Grid.Row="5" Grid.Column="1" Grid.RowSpan="2" Margin="0,15,0,0" AcceptsReturn="True" TextWrapping="Wrap" />

        <StackPanel Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,10,0" Width="100"/>
            <Button Content="Confirm Adjustment" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" Width="160"/>
        </StackPanel>
    </Grid>
</Window>
