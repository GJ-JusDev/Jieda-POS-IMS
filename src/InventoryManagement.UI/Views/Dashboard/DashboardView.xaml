<UserControl x:Class="InventoryManagement.UI.Views.Dashboard.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="1000">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="Dashboard" Style="{StaticResource Heading1}" Margin="0"/>
                <TextBlock Text="Overview of your inventory and sales performance." Foreground="{StaticResource TextSecondaryBrush}" FontSize="15" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Top Cards -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sales Card -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource SuccessBrush}" BorderThickness="0,4,0,0" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Today's Sales" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Metrics.TodaySales, StringFormat=C}" Foreground="{StaticResource SuccessBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Purchases Card -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,4,0,0" Margin="10,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Today's Purchases" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Metrics.TodayPurchases, StringFormat=C}" Foreground="{StaticResource AccentBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Inventory Value Card -->
                <Border Grid.Column="2" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource InfoBrush}" BorderThickness="0,4,0,0" Margin="10,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total Inventory Value" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <TextBlock Text="{Binding Metrics.TotalInventoryValue, StringFormat=C}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="32" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <!-- Alerts Card -->
                <Border Grid.Column="3" Style="{StaticResource CardStyle}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="0,4,0,0" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Stock Alerts" Foreground="{StaticResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        
                        <StackPanel Grid.Row="1" Grid.Column="0">
                            <TextBlock Text="OUT" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Metrics.OutOfStockCount}" Foreground="{StaticResource DangerBrush}" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1">
                            <TextBlock Text="LOW" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Metrics.LowStockCount}" Foreground="{StaticResource WarningBrush}" FontSize="28" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Lower Section -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto" MinWidth="320"/>
                </Grid.ColumnDefinitions>

                <!-- Recent Movements -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,10,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="20,15" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="Recent Stock Movements" Style="{StaticResource Heading3}" Margin="0"/>
                        </Border>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding RecentMovements}" Margin="0,0,0,10" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:g}}" Width="140"/>
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="160"/>
                                <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, StringFormat={}{0:+#;-#;0}}" Width="80">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="HorizontalAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Ref" Binding="{Binding Reference}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Summary Analytics -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0" Margin="10,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <Border Background="{StaticResource HeaderBgBrush}" Padding="20,15" CornerRadius="8,8,0,0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                            <TextBlock Text="System Summary" Style="{StaticResource Heading3}" Margin="0"/>
                        </Border>
                        
                        <StackPanel Grid.Row="1" Margin="25">
                            <StackPanel Orientation="Horizontal" Margin="0,15">
                                <TextBlock Text="Active Products:" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Width="160" />
                                <TextBlock Text="{Binding Metrics.TotalActiveProducts}" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,15">
                                <TextBlock Text="Active Customers:" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Width="160" />
                                <TextBlock Text="{Binding Metrics.TotalActiveCustomers}" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,15">
                                <TextBlock Text="Active Suppliers:" FontSize="15" Foreground="{StaticResource TextSecondaryBrush}" Width="160" />
                                <TextBlock Text="{Binding Metrics.TotalActiveSuppliers}" FontSize="15" FontWeight="Bold" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
