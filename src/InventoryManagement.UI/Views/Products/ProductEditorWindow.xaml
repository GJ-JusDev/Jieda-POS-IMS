<Window x:Class="InventoryManagement.UI.Views.Products.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Editor" MinHeight="650" MinWidth="900" Height="700" Width="1000" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PRODUCT DETAILS" Style="{StaticResource Heading1}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                <StackPanel>
                    
                    <!-- PRODUCT INFORMATION -->
                    <StackPanel Margin="0,0,0,30">
                        <TextBlock Text="Product Information" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Separator Margin="0,5,0,15" Background="{StaticResource BorderBrush}"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Product Name" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Product.ProductName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="SKU" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Product.SKU, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="Barcode" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Image Source="{Binding BarcodeImage}" Height="50" Margin="0,10,0,0" HorizontalAlignment="Left" Stretch="Uniform"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Category" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding Product.CategoryId}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Unit of Measure" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="UnitName" SelectedValuePath="UnitId" SelectedValue="{Binding Product.UnitId}"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Margin="0,0,0,5">
                            <TextBlock Text="Description" FontWeight="SemiBold" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Product.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="70"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- INVENTORY -->
                    <StackPanel Margin="0,0,0,30" Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Initial Inventory" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Separator Margin="0,5,0,15" Background="{StaticResource BorderBrush}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Initial Stock Quantity" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding InitialStockText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Total Initial Stock Value" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding TotalInitialValueText, Mode=OneWay}" IsReadOnly="True" Background="{StaticResource BackgroundBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    
                    <!-- PRICING -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Pricing" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Separator Margin="0,5,0,15" Background="{StaticResource BorderBrush}"/>
                        
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Cost Price" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding Product.IsManufactured}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Custom Markup %" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding MarkupPercentageText, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Grid.Column="1" Text="%" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                </Grid>
                                <TextBlock Text="Selling price is automatically calculated using the cost price and your chosen markup." FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Selling Price" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding SellingPriceText, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- RIGHT PANEL: Manufacturing -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Padding="0,0,15,0">
                <StackPanel>
                    <TextBlock Text="Manufacturing" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Separator Margin="0,5,0,15" Background="{StaticResource BorderBrush}"/>
                    
                    <CheckBox IsChecked="{Binding Product.IsManufactured}" Margin="0,0,0,5">
                        <TextBlock Text="This product is manufactured from raw materials" FontWeight="SemiBold" FontSize="14"/>
                    </CheckBox>
                    <TextBlock Text="This product is produced using other inventory items or raw materials." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="25,0,0,25"/>
                    
                    <StackPanel Visibility="{Binding Product.IsManufactured, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Bill of Materials" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Separator Margin="0,5,0,10" Background="{StaticResource BorderBrush}"/>
                        <TextBlock Text="Add the materials/components required to produce one unit." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,15"/>
                        
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRawMaterials}" SelectedItem="{Binding SelectedRawMaterial}" DisplayMemberPath="ProductName"/>
                            <TextBox Grid.Column="2" Text="{Binding ComponentQuantityText, UpdateSourceTrigger=PropertyChanged}" ToolTip="Quantity Used"/>
                            <Button Grid.Column="4" Content="Add" Command="{Binding AddComponentCommand}" Style="{StaticResource SuccessButton}" Padding="15,6"/>
                        </Grid>
                        
                        <ListView ItemsSource="{Binding Components}" MinHeight="180" MaxHeight="400" Margin="0,0,0,20" BorderBrush="{StaticResource BorderBrush}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Raw Material" DisplayMemberBinding="{Binding RawMaterial.ProductName}" Width="220"/>
                                    <GridViewColumn Header="Quantity" DisplayMemberBinding="{Binding QuantityUsed}" Width="70"/>
                                    <GridViewColumn Header="Action" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Remove" Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Style="{StaticResource DangerButton}" Padding="8,4" FontSize="12"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Auto-Calculate Cost Price" Command="{Binding CalculateCostCommand}" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,0,0,5"/>
                        <TextBlock Text="Calculates cost from the current Bill of Materials." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- FOOTER: Save / Cancel -->
        <Border Grid.Row="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="-30,20,-30,-30" Padding="30,20">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Margin="0,0,15,0" Padding="25,8"/>
                <Button Content="Save" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="25,8"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>


