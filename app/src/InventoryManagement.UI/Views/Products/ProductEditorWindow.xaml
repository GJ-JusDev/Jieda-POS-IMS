<Window x:Class="InventoryManagement.UI.Views.Products.ProductEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Product Editor" Height="600" Width="800" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Product Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Basic Info -->
            <StackPanel Grid.Column="0">
                <StackPanel Margin="0,5">
                    <TextBlock Text="Product Name"/>
                    <TextBox Text="{Binding Product.ProductName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Margin="0,5">
                    <TextBlock Text="SKU"/>
                    <TextBox Text="{Binding Product.SKU, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Margin="0,5">
                    <TextBlock Text="Barcode"/>
                    <TextBox Text="{Binding BarcodeText, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    <Image Source="{Binding BarcodeImage}" Height="40" Margin="0,5,0,0" HorizontalAlignment="Left"/>
                </StackPanel>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Category"/>
                        <ComboBox ItemsSource="{Binding Categories}" DisplayMemberPath="CategoryName" SelectedValuePath="CategoryId" SelectedValue="{Binding Product.CategoryId}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unit of Measure"/>
                        <ComboBox ItemsSource="{Binding Units}" DisplayMemberPath="UnitName" SelectedValuePath="UnitId" SelectedValue="{Binding Product.UnitId}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Initial Stock Quantity"/>
                        <TextBox Text="{Binding InitialStockText, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Visibility="{Binding IsNewProduct, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Total Initial Stock Value"/>
                        <TextBox Text="{Binding TotalInitialValueText, Mode=OneWay}" Padding="5" IsReadOnly="True" Background="#e9ecef"/>
                    </StackPanel>
                </Grid>
                
                <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cost Price"/>
                        <TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" Padding="5" IsReadOnly="{Binding Product.IsManufactured}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Selling Price"/>
                        <TextBox Text="{Binding SellingPriceText, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,15,0,5">
                    <TextBlock Text="Description"/>
                    <TextBox Text="{Binding Product.Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="60" Padding="5"/>
                </StackPanel>
            </StackPanel>

            <!-- RIGHT PANEL: Manufacturing / Costing -->
            <Border Grid.Column="2" Background="#f8f9fa" Padding="15" CornerRadius="5" BorderBrush="#dee2e6" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Manufacturing &amp; Pricing" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <CheckBox IsChecked="{Binding Product.IsManufactured}" Content="This product is manufactured from raw materials" Margin="0,0,0,15" FontWeight="SemiBold"/>
                    
                    <StackPanel Visibility="{Binding Product.IsManufactured, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Bill of Materials (BOM)" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <ComboBox Grid.Column="0" ItemsSource="{Binding AvailableRawMaterials}" SelectedItem="{Binding SelectedRawMaterial}" DisplayMemberPath="ProductName" Padding="5" Margin="0,0,0,0" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="2" Text="{Binding ComponentQuantityText, UpdateSourceTrigger=PropertyChanged}" Padding="5" VerticalAlignment="Center" ToolTip="Quantity Used"/>
                            <Button Grid.Column="4" Content="Add" Command="{Binding AddComponentCommand}" Padding="10,5" Background="#28a745" Foreground="White"/>
                        </Grid>
                        
                        <ListView ItemsSource="{Binding Components}" Height="120" Margin="0,0,0,10">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Raw Material" DisplayMemberBinding="{Binding RawMaterial.ProductName}" Width="150"/>
                                    <GridViewColumn Header="Qty" DisplayMemberBinding="{Binding QuantityUsed}" Width="60"/>
                                    <GridViewColumn Header="Action" Width="60">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="X" Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=ListView}}" CommandParameter="{Binding}" Background="#dc3545" Foreground="White"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        <Button Content="Auto-Calculate Cost Price" Command="{Binding CalculateCostCommand}" Padding="10,5" Background="#17a2b8" Foreground="White" Margin="0,0,0,15"/>
                    </StackPanel>

                    <TextBlock Text="Automated Markup" FontWeight="SemiBold" Margin="0,15,0,5"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Target Margin %: " VerticalAlignment="Center"/>
                        <TextBox Text="{Binding MarkupPercentageText, UpdateSourceTrigger=PropertyChanged}" Width="60" Padding="5"/>
                        <TextBlock Text=" (auto-updates Selling Price)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- FOOTER: Save / Cancel -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" IsCancel="True" Padding="15,5" Margin="0,0,10,0" Background="#6c757d" Foreground="White"/>
            <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,5" Background="#007bff" Foreground="White" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>


