<Window x:Class="InventoryManagement.UI.Views.Purchasing.PurchaseEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Purchase Order Editor" Height="600" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Purchase Order Details" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Header Info -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Supplier"/>
                                                <TextBox Text="{Binding SupplierText, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Notes"/>
                <TextBox Text="{Binding Purchase.Notes, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </StackPanel>
        </Grid>

        <!-- Add Item Section -->
        <Border Grid.Row="2" Background="#f8f9fa" Padding="15" BorderBrush="#dee2e6" BorderThickness="1" CornerRadius="5" Margin="0,0,0,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Product"/>
                    <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" DisplayMemberPath="ProductName" Padding="5"/>
                </StackPanel>
                
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Quantity"/>
                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="Unit Cost"/>
                    <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </StackPanel>

                <Button Grid.Column="6" Content="Add Item" Command="{Binding AddItemCommand}" Padding="15,5" Margin="0,15,0,0" Background="#28a745" Foreground="White" VerticalAlignment="Bottom"/>
            </Grid>
        </Border>

        <!-- Items Grid -->
        <DataGrid Grid.Row="3" ItemsSource="{Binding PurchaseItems}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding Product.ProductName}" Width="*"/>
                <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" Width="80"/>
                <DataGridTextColumn Header="Unit Cost" Binding="{Binding UnitCost, StringFormat=C}" Width="100"/>
                <DataGridTextColumn Header="Subtotal" Binding="{Binding TotalCost, StringFormat=C}" Width="120">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
            <DataGrid.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Remove Item" Command="{Binding RemoveItemCommand}"/>
                </ContextMenu>
            </DataGrid.ContextMenu>
        </DataGrid>

        <!-- Footer -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Button Grid.Column="0" Content="Remove Selected Item" Command="{Binding RemoveItemCommand}" Padding="10,5" Background="#dc3545" Foreground="White"/>
            
            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <TextBlock Text="Total:" FontSize="18" FontWeight="Bold" Margin="0,0,10,0" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Purchase.TotalAmount, StringFormat=C}" FontSize="18" FontWeight="Bold" Foreground="#007bff" Margin="0,0,20,0" VerticalAlignment="Center"/>
                <Button Content="Close / Save" Command="{Binding SaveCommand}" Width="100" Padding="5" Background="#007bff" Foreground="White"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>





